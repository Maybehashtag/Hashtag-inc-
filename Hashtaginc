manualFarmNow=function()
 -- FARM NOW is deliberately a one-server action. It never enables the
 -- Auto Farm loop, never queues itself across teleports, and never server-hops.
 if dead or running or hopBusy or countdownActive then return end
 autoLoop=false
 countdownToken+=1
 countdownActive=false
 countdownRemaining=0
 countdownLastTick=0
 countdownDeadline=0
 clearAutoResume()
 routeStatus.Text="FARM NOW / scanning current server"
 setWebhookStatus("Farm Now • current server only")
 log("FARM NOW: farming this server only; server hopping is disabled.")

 local ok,err=pcall(scan)
 if not ok then
  routeStatus.Text="FARM NOW / scan failed"
  log("FARM NOW scan error: "..tostring(err))
  return
 end

 start(false)
end

beginResumeHandoff=function()
 if resumeReadyBusy then return end
 resumeReadyBusy=true

 local completed,problem=xpcall(function()
  local readyDeadline=os.clock()+30
  local emptyScanSince=nil
  local lastReason="Waiting for game data"

  while os.clock()<readyDeadline and not dead and autoLoop do
   local character=player.Character
   local humanoid=character and character:FindFirstChildOfClass("Humanoid")
   local root=character and character:FindFirstChild("HumanoidRootPart")

   if not humanoid or humanoid.Health<=0 or not root then
    lastReason="Waiting for character"
   elseif humanoid.SeatPart then
    lastReason="Waiting to be on foot"
   else
    local scanOk,scanErr=pcall(scan)
    if not scanOk then
     lastReason="Scan error"
     log("AUTO FARM++ scan error: "..tostring(scanErr))
    else
     local readyCount=0
     for _,r in ipairs(rows) do
      local ok,isReady=pcall(updateAvailability,r)
      if ok and isReady then readyCount+=1 end
     end

     if #rows>0 and readyCount>0 then
      emptyScanSince=nil
      routeStatus.Text="AUTO FARM++ / starting"
      setWebhookStatus("Starting farm • "..readyCount.." cashier(s) ready")
      log("AUTO FARM++ handoff: "..readyCount.." ready / "..#rows.." scanned.")
      start(true)
      if running then return end
      lastReason=routeStatus.Text
     elseif #rows>0 then
      routeStatus.Text="AUTO FARM++ / no available cashiers / hopping"
      setWebhookStatus("No cashiers available • hopping")
      log("AUTO FARM++: cashiers loaded but none are available; hopping immediately.")
      hopForAutoFarm()
      return
     else
      emptyScanSince=emptyScanSince or os.clock()
      if os.clock()-emptyScanSince>=4 then
       routeStatus.Text="AUTO FARM++ / no cashiers found / hopping"
       setWebhookStatus("No cashiers found • hopping")
       log("AUTO FARM++: no cashier prompts appeared after a short load grace; hopping.")
       hopForAutoFarm()
       return
      end
      lastReason="Loading cashier prompts"
     end
    end
   end

   routeStatus.Text="AUTO FARM++ / "..lastReason
   webhookStatus=lastReason
   webhookDirty=true
   task.wait(0.75)
  end

  if dead or not autoLoop then return end

  routeStatus.Text="AUTO FARM++ / not ready / hopping"
  setWebhookStatus("Server did not become farm-ready • hopping again")
  log("AUTO FARM++: not farm-ready after 30s; hopping again.")
  hopForAutoFarm()
 end,debug.traceback)

 resumeReadyBusy=false
 if not completed then
  routeStatus.Text="AUTO FARM++ / resume error"
  log("AUTO FARM++ resume error: "..tostring(problem))
  setWebhookStatus("Resume error")
  task.wait(1)
  if not dead and autoLoop then hopForAutoFarm() end
 end
end

