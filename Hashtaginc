 local cashierSection=section(farm,"Cashiers",true)
 local cashierControls={}
 local function refreshCashiers()
  local present={}
  for _,r in ipairs(rows) do
   present[r]=true
   if not cashierControls[r] then
    local initialDesc=available(r) and "Ready" or "Busy"
    local entry={syncing=false,lastSelected=r.selected,lastDesc=initialDesc}
    entry.control=cashierSection:Toggle({
     Title=r.name,
     Value=r.selected,
     Desc=initialDesc,
     Callback=function(value)
      if not entry.syncing and not running then r.selected=value end
     end
    })
    cashierControls[r]=entry
   end
   local entry=cashierControls[r]
   if entry.lastSelected~=r.selected then
    entry.lastSelected=r.selected
    entry.syncing=true
    entry.control:Set(r.selected)
    entry.syncing=false
   end
   local desc=available(r) and "Ready" or "Busy"
   if entry.lastDesc~=desc then
    entry.lastDesc=desc
    entry.control:SetDesc(desc)
   end
  end
  for r,entry in pairs(cashierControls) do
   if not present[r] then
    entry.control:Destroy()
    cashierControls[r]=nil
   end
  end
 end

