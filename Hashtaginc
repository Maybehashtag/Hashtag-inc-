local function pauseAfkForRoute(busy)

 afkRouteBusy=busy

 afkGeneration+=1

 releaseAfkKeys()

 if busy then afkStatus="Paused / robbing" else afkNext=os.clock()+3 afkStatus="Waiting / native keys" end

end

local function afkReady()

 if dead or not afkEnabled then return false,"Off" end

 if afkRouteBusy then return false,"Paused / robbing" end

 if type(keypress)~="function" or type(keyrelease)~="function" or type(isrbxactive)~="function" then return false,"Native input unavailable" end

 if not isrbxactive() then return false,"Paused / focus Roblox" end

 if UIS:GetFocusedTextBox() or game:GetService("GuiService").MenuIsOpen then return false,"Paused / typing or menu" end

 local c=player.Character local h=c and c:FindFirstChildOfClass("Humanoid") local root=c and c:FindFirstChild("HumanoidRootPart")

 if not h or not root or h.Health<=0 or root.Anchored then return false,"Waiting for character" end

 if h.SeatPart then return false,"Paused / seated" end

 if h.FloorMaterial==Enum.Material.Air then return false,"Waiting for ground" end

 if os.clock()-afkLastManual<12 then return false,"Watching / player active" end

 return true,"Ready"

end

local function pulseAfkKey(key,seconds,token)

 local ready=afkReady()

 if not ready or token~=afkGeneration then return false end

 afkHeld[key]=true

 keypress(key)

 local finish=os.clock()+seconds

 while os.clock()<finish do

  if dead or token~=afkGeneration or afkRouteBusy or not isrbxactive() or UIS:GetFocusedTextBox() then releaseAfkKeys() return false end

  task.wait(0.02)

 end

 keyrelease(key) afkHeld[key]=nil

 return true

end

local function performAfkPulse()

 if afkBusy then return end

 local ready,reason=afkReady()

 if not ready then afkStatus=reason return end

 afkBusy=true

 local token=afkGeneration

 local startJob=game.JobId

 local ok,err=xpcall(function()

  afkStatus="Active / native W + S + jump"

  if not pulseAfkKey(0x57,0.15,token) then return end

  task.wait(0.12)

  if not pulseAfkKey(0x53,0.15,token) then return end

  task.wait(0.12)

  if not pulseAfkKey(0x20,0.08,token) then return end

  gui:SetAttribute("AfkPulses",(gui:GetAttribute("AfkPulses") or 0)+1)

  gui:SetAttribute("AfkSameServer",game.JobId==startJob)

 end,debug.traceback)

 releaseAfkKeys()

 afkBusy=false afkNext=os.clock()+afkInterval

 if not ok then

  afkEnabled=false afkStatus="Off / input error"

  log("Anti-AFK stopped: "..tostring(err))

 elseif afkRouteBusy then afkStatus="Paused / robbing"

 else afkStatus="Waiting / native keys" end

end

