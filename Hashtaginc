local function findServerHopTarget()
 rememberVisitedJob(game.JobId)
 local blocked={}
 for id in pairs(visitedJobs) do blocked[id]=true end
 if previousJob~="" then blocked[previousJob]=true end

 local cursor=nil
 local candidates={}
 for _=1,12 do
  local url=string.format(
   "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true",
   game.PlaceId
  )
  if cursor then url..="&cursor="..HttpService:UrlEncode(cursor) end

  local payload=HttpService:JSONDecode(game:HttpGet(url))
  for _,server in ipairs(payload.data or {}) do
   if type(server.id)=="string" and not blocked[server.id] and (server.playing or 0)<(server.maxPlayers or math.huge) then
    table.insert(candidates,server)
   end
  end

  if #candidates>=20 then break end
  cursor=payload.nextPageCursor
  if not cursor or cursor=="" then break end
 end

 if #candidates==0 then return nil,"No unvisited non-full public server found." end
 table.sort(candidates,function(a,b) return (a.playing or 0)<(b.playing or 0) end)
 local pool=math.min(#candidates,20)
 return candidates[math.random(1,pool)].id
end

