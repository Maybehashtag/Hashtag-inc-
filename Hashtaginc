 table.insert(cleanups,function() if not windowDestroyed then windowDestroyed=true window:Destroy() end end)
 window:OnDestroy(function() windowDestroyed=true destroy() end)
 local syncers={}
 local ready=false
 local bound,missing=0,0

 local findCache=setmetatable({}, {__mode="k"})
 local function find(root,name)
  if not root then return nil end
  local cache=findCache[root]
  if not cache then cache={} findCache[root]=cache end
  local cached=cache[name]
  if cached and cached.Parent then return cached end
  local found=root:FindFirstChild(name,true)
  if found then cache[name]=found end
  return found
 end

 local function notify(title,content,icon,duration)
  pcall(function()
   WindUI:Notify({
    Title=tostring(title or "Hashtag inc."),
    Content=tostring(content or ""),
    Icon=icon or "bell",
    Duration=duration or 3,
   })
  end)
 end

 local function invoke(object,event,...)
  if dead or not ready then return end
  local fn=object and uiHandlers[object] and uiHandlers[object][event]
  if not fn then log("Control unavailable.") return end
  local ok,err=pcall(fn,...)
  if not ok then log("Control error: "..tostring(err)) end
 end

 local function verify(o,event)
  bound+=1
  if not (o and uiHandlers[o] and uiHandlers[o][event]) then missing+=1 end
 end

 local function section(tab,title,opened)
  return tab:Section({Title=title,Opened=opened})
 end

 local function card(parent,title,get)
  local last=tostring(get() or "")
  local c=parent:Button({Title=title,Desc=last,Icon="",Callback=function() end})
  table.insert(syncers,function()
   local text=tostring(get() or "")
   if text~=last then last=text c:SetDesc(text) end
  end)
  return c
 end

 local function action(parent,title,o,icon,noticeText)
  verify(o,"Activated")
  return parent:Button({Title=title,Icon=icon or "",Callback=function()
   invoke(o,"Activated")
   if noticeText then
    task.defer(function()
     local content=type(noticeText)=="function" and noticeText() or noticeText
     if content and content~="" then notify(title,content,icon or "check",3) end
    end)
   end
  end})
 end

 local function toggle(parent,title,o,get)
  verify(o,"Activated")
  local syncing=false
  local last=get()
  local c=parent:Toggle({Title=title,Value=last,Callback=function(value)
   if not syncing and ready and value~=get() then
    invoke(o,"Activated")
    task.defer(function()
     local actual=get()
     notify(title,actual and "Enabled" or "Disabled",actual and "check" or "x",2.5)
    end)
   end
  end})
  table.insert(syncers,function()
   local value=get()
   if value~=last then last=value syncing=true c:Set(value) syncing=false end
  end)
  return c
 end

 local function input(parent,o,title)
  if not o then missing+=1 return end
  verify(o,"FocusLost")
  local ticket=0
  local c=parent:Input({Title=title,Value=o.Text,Desc="Current: "..o.Text,
   Placeholder="Enter a number",Callback=function(value)
    if not ready then return end
    local text=tostring(value)
    if not tonumber(text) then
     notify(title,"Enter a valid number.","triangle-alert",2.5)
     return
    end
    ticket+=1
    local current=ticket
    task.delay(0.6,function()
     if dead or current~=ticket or not o.Parent then return end
     o.Text=text
     invoke(o,"FocusLost",true)
     notify(title,"Updated to "..tostring(o.Text),"settings",2.5)
    end)
   end})
  local last=o.Text
  table.insert(syncers,function()
   if o.Text~=last then last=o.Text c:SetDesc("Current: "..last) end
  end)
  return c
 end

