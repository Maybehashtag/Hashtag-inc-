local function wheelSet(a,key,value)

 if a.seat.AssemblyLinearVelocity.Magnitude>3 then notice="Park the car before changing wheel anchors." return false end

 local count=0

 for _,w in ipairs(a.wheelOrder) do if matches(w) then

  local e=a.wheelEdits[w] e[key]=value

  local delta=CFrame.new(e.X,e.Y,e.Z)*CFrame.Angles(math.rad(e.RX),math.rad(e.RY),math.rad(e.RZ))

  for att,o in pairs(a.anchors) do if att:IsDescendantOf(w) then att.CFrame=o*delta count+=1 end end

 end end

 if count==0 then error("Supported wheel axle anchors unavailable") end

 return true

end

