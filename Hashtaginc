local function available(r)

 local data=r.owner:FindFirstChild("Data")

 return r.prompt:IsDescendantOf(workspace) and r.prompt.Enabled and r.owner:GetAttribute("IsBusy")~=true and (not data or data:GetAttribute("IsBusy")~=true)

