 currentUses=math.max(0,math.floor(tonumber(currentUses) or 0))

 -- Buy only for cashiers that are actually ready now. Existing Remaining_Uses
 -- count toward the requirement, and one new lockpick contributes 3 uses.
 local missingUses=math.max(0,readyCount-currentUses)
 local quantity=math.ceil(missingUses/LOCKPICK_USES)
 local cost=quantity*LOCKPICK_PRICE

 if quantity<=0 then return true,0 end

 if cost>config.maxSpend or not balance() or balance()<cost then return false,"Purchase exceeds budget or balance." end

 local rs=game:GetService("ReplicatedStorage")

 local a=rs:FindFirstChild("Replicated") local b=a and a:FindFirstChild("Events") local c=b and b:FindFirstChild("MarketEvent") local remote=c and c:FindFirstChild("Event")

 if not remote or not remote:IsA("RemoteFunction") then return false,"Market unavailable." end

 routeStatus.Text="BUYING  /  "..quantity.." lockpick(s) for "..readyCount.." ready cashier(s)"
 setWebhookStatus("Buying "..quantity.." lockpick(s) for "..readyCount.." ready cashier(s)…")

 local done,ok,result=false,false,nil

 purchasePending=true

 task.spawn(function()

  if valid(token) then ok,result=pcall(function() return remote:InvokeServer("Buy",{[TOOL]=quantity},cost) end) end

  done=true purchasePending=false

 end)

 local deadline=os.clock()+10

 while not done and os.clock()<deadline and valid(token) do task.wait(0.05) end

 if not valid(token) then return false,"Stopped; an already-sent purchase may still complete." end

 if not done then return false,"Purchase outcome unknown; check inventory before restarting." end

 if not ok or result~="تم الشراء" then return false,"Purchase not confirmed: "..tostring(result) end

 spent+=cost

 if not waitFor(0.15,token) then return false,"Stopped after purchase." end
 return true,quantity

end

local function attempt(r,token)

 if not r.prompt.Parent then return "missing" end

 if not available(r) or r.awaitCycle then return "busy" end

 local character=player.Character local h=character and character:FindFirstChildOfClass("Humanoid") local root=character and character:FindFirstChild("HumanoidRootPart")

 if not h or not root or h.Health<=0 then return "character" end

 if h.SeatPart then return "seated" end

 local tool,usesBefore=inventory() if not tool then return "tool" end

 local prompt=r.prompt local target=cf(prompt) if not target then return "missing" end

 local original={hold=prompt.HoldDuration,distance=prompt.MaxActivationDistance,los=prompt.RequiresLineOfSight,anchored=root.Anchored,ragdoll=h:GetStateEnabled(Enum.HumanoidStateType.Ragdoll),falling=h:GetStateEnabled(Enum.HumanoidStateType.FallingDown),platform=h.PlatformStand}

 local camera=workspace.CurrentCamera

 local cameraOriginal=camera and {kind=camera.CameraType,subject=camera.CameraSubject,cf=camera.CFrame,focus=camera.Focus}

 local collision={}

 local cleaned=false

 local stabilityConnection

 local cameraBound=false

 local cameraBinding="MonochromeRouteCamera"

 local function cleanup()

  if cleaned then return end cleaned=true

  if stabilityConnection then stabilityConnection:Disconnect() end

  if cameraBound then RunService:UnbindFromRenderStep(cameraBinding) cameraBound=false end

  pcall(function() prompt:InputHoldEnd() prompt.HoldDuration=original.hold prompt.MaxActivationDistance=original.distance prompt.RequiresLineOfSight=original.los end)

  for part,value in pairs(collision) do if part.Parent then part.CanCollide=value end end

  if root.Parent then root.Anchored=original.anchored end

  if h.Parent then h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,original.ragdoll) h:SetStateEnabled(Enum.HumanoidStateType.FallingDown,original.falling) h.PlatformStand=original.platform end

  if config.camera and camera and cameraOriginal then pcall(function() camera.CameraType=cameraOriginal.kind camera.CameraSubject=cameraOriginal.subject camera.CFrame=cameraOriginal.cf camera.Focus=cameraOriginal.focus end) end

 end

 restoreAttempt=cleanup

 local result="error"

 local ok,err=xpcall(function()

  local function stabilize()

   if cleaned or not root.Parent or not h.Parent then return end

   h.PlatformStand=false h.Sit=false

   root.AssemblyAngularVelocity=Vector3.zero

   if root.AssemblyLinearVelocity.Magnitude>40 then root.AssemblyLinearVelocity=Vector3.zero end

   local state=h:GetState()

   if state==Enum.HumanoidStateType.Ragdoll or state==Enum.HumanoidStateType.FallingDown then h:ChangeState(Enum.HumanoidStateType.GettingUp) end

   for _,part in ipairs(character:GetDescendants()) do if part:IsA("BasePart") then

    if collision[part]==nil then collision[part]=part.CanCollide end

    part.CanCollide=false

   end end

  end

  h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)

  h:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)

  stabilize()

  stabilityConnection=RunService.Heartbeat:Connect(stabilize)

  root.Anchored=true root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero

  -- Same approach as the supplied moveToPrompt: local offset, level facing,

  -- two physics frames, then GettingUp. Guard vertically oriented attachments.

  local raw=target*CFrame.new(0,0,2.25)

  local stand=raw.Position

  local lookAt=Vector3.new(target.X,stand.Y,target.Z)

  if (lookAt-stand).Magnitude<=0.05 then

   local direction=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)

   if direction.Magnitude<0.05 then direction=Vector3.new(0,0,-1) end

   stand=target.Position-direction.Unit*2.25

   lookAt=Vector3.new(target.X,stand.Y,target.Z)

  end

  character:PivotTo(CFrame.lookAt(stand,lookAt))

  RunService.Heartbeat:Wait()

  if not valid(token) then result="cancel" return end

  RunService.Heartbeat:Wait()

  if not valid(token) then result="cancel" return end

  root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero

  root.Anchored=original.anchored

  h.PlatformStand=false h.Sit=false h:ChangeState(Enum.HumanoidStateType.GettingUp)

  local facing=Vector3.new(target.X,root.Position.Y,target.Z)

  if (facing-root.Position).Magnitude>0.05 then root.CFrame=CFrame.lookAt(root.Position,facing) end

  if config.camera and camera then

   local params=RaycastParams.new()

   params.FilterType=Enum.RaycastFilterType.Exclude

   local part=prompt.Parent

   while part and not part:IsA("BasePart") do part=part.Parent end

   local filters={character} if part then table.insert(filters,part) end

   params.FilterDescendantsInstances=filters

   RunService:BindToRenderStep(cameraBinding,Enum.RenderPriority.Camera.Value+1,function()

    if cleaned or not root.Parent or not prompt.Parent then return end

    local now=cf(prompt) if not now then return end

    local position=now.Position

    local desired=root.Position+Vector3.new(0,1.7,0)

    local ray=desired-position

    if ray.Magnitude<0.3 then ray=Vector3.new(0,1,2) desired=position+ray end

    local hit=workspace:Raycast(position,ray,params)

    if hit then desired=position+ray.Unit*math.max(0.35,hit.Distance-0.20) end

    local direction=position-desired

    local up=Vector3.yAxis

    if math.abs(direction.Unit:Dot(up))>0.995 then up=Vector3.zAxis end

    camera.CameraType=Enum.CameraType.Scriptable

    camera.CFrame=CFrame.lookAt(desired,position,up)

    camera.Focus=CFrame.new(position)

   end)

   cameraBound=true

   RunService.RenderStepped:Wait()

   if not valid(token) then result="cancel" return end

   RunService.RenderStepped:Wait()

  end

  if not waitFor(config.delay,token) then result="cancel" return end

  if not available(r) then result="busy" return end

  h:EquipTool(tool)

  -- Usually synchronous, but this tiny conditional wait fixes cases where the
  -- prompt fires before the lockpick actually reaches the character.
  local equipDeadline=os.clock()+0.25
  while tool.Parent~=character and os.clock()<equipDeadline do
   if not valid(token) then result="cancel" return end
   RunService.Heartbeat:Wait()
  end
  if tool.Parent~=character then result="tool" return end

  if config.fastHold then prompt.HoldDuration=0.0001 end

  prompt.RequiresLineOfSight=false
  prompt.MaxActivationDistance=math.max(original.distance,10)

  local before=balance()

  prompt:InputHoldBegin()

  if not waitFor(math.max(0.05,prompt.HoldDuration+0.03),token) then result="cancel" return end

  prompt:InputHoldEnd()

  -- Two-stage confirmation. We only spend ~1.6s waiting for the server to
  -- acknowledge the robbery. If a lockpick use is consumed, we do NOT retry;
  -- we give the balance a short grace period and then continue as accepted.
  local started=os.clock()
  local acceptDeadline=started+math.min(config.timeout,1.60)
  local hardDeadline=started+math.max(1.60,config.timeout)
  local consumedAt=nil
  local busyAt=nil

  local function markCycle(nowReady)
   r.awaitCycle=true
   r.observedAt=os.clock()
   r.sawUnavailable=not nowReady
   if not nowReady then
    r.wasReady=false
    r.fullTransition=true
    r.unavailableAt=r.unavailableAt or os.clock()
   end
  end

  while true do
   if not valid(token) then result="cancel" return end

   local _,remaining=inventory()
   local current=balance()
   local nowReady=available(r)
   local now=os.clock()

   if remaining<usesBefore and not consumedAt then consumedAt=now end
   if not nowReady and not busyAt then busyAt=now end

   local payoutDelta=(before and current) and (current-before) or 0
   if payoutDelta>=3000 and (consumedAt or busyAt) then
    sessionPayouts+=1
    if autoLoop then
     autoEarned+=payoutDelta
     autoPayouts+=1
     setTeleportState(AUTO_EARNED_KEY,autoEarned)
     setTeleportState(AUTO_PAYOUTS_KEY,autoPayouts)
     recordBalanceSnapshot(false)
     setWebhookStatus("Payout confirmed • +"..commaNumber(payoutDelta).." Riyal")
    end
    markCycle(nowReady)
    result="observed"
    log(r.name..": payout confirmed +"..payoutDelta..".")
    return
   end

   -- Use consumption is a strong acceptance signal. Waiting the old full timeout
   -- here could cause duplicate retries and burn extra lockpick uses.
   if consumedAt and (now-consumedAt>=0.60 or now>=hardDeadline) then
    markCycle(nowReady)
    result="accepted"
    log(r.name..": lockpick use consumed; payout replication still pending.")
    return
   end

   -- Busy with no consumed use is treated as a cashier race, not a failed rob.
   if not consumedAt and busyAt and now-busyAt>=0.30 then
    result="busy"
    return
   end

   if not consumedAt and now>=acceptDeadline then
    result="no-response"
    return
   end

   if now>=hardDeadline then
    result=consumedAt and "accepted" or "no-response"
    return
   end

   task.wait(0.03)
  end
 end,debug.traceback)

 cleanup() if restoreAttempt==cleanup then restoreAttempt=nil end

 if not ok then log("Attempt error: "..tostring(err)) result="error" end

 return result

end

local function start(loopMode)
 if running then return end
 if purchasePending then routeStatus.Text="Purchase still pending" return end
 if not loopMode and player.PlayerGui:FindFirstChild("RouteMenu") then routeStatus.Text="Close RouteMenu first" return end

 local char=player.Character
 local h=char and char:FindFirstChildOfClass("Humanoid")
 if not h or h.Health<=0 or h.SeatPart then routeStatus.Text="Stand outside the car first" return end

 if loopMode and not queueApi() then
  routeStatus.Text="AUTO FARM++ / teleport queue unavailable"
  log("AUTO FARM++ needs queueonteleport / queue_on_teleport support.")
  return
 end

 local targets={}
 for _,r in ipairs(rows) do
  if loopMode or r.selected then table.insert(targets,r) end
 end
 if #targets==0 then routeStatus.Text="No cashiers selected" return end

 pauseAfkForRoute(true)
 running=true autoLoop=loopMode==true generation+=1
 local token=generation

 gui:SetAttribute("Running",true)
 startingBalance=startingBalance or balance()
 attempts=0 confirmed=0 uncertain=0 skipped=0 spent=0

 task.spawn(function()
  local ok,err=xpcall(function()
   local queue={}
   for _,r in ipairs(targets) do
    if updateAvailability(r) then
     table.insert(queue,r)
     r.status="Queued"
    end
   end

   if #queue==0 then
    if loopMode then
     routeStatus.Text="AUTO FARM++ / no ready cashiers / hopping"
     hopForAutoFarm()
    else
     stopRoute("No selected cashier is ready")
    end
    return
   end

   -- Recheck readiness immediately before spending. A cashier may have become
   -- busy after the scan, and we should never buy a lockpick for that cashier.
   if not waitFor(READY_RECHECK,token) then return end
   local readyNow={}
   for _,r in ipairs(queue) do
    if updateAvailability(r) then
     table.insert(readyNow,r)
    else
     r.status="Busy"
    end
   end
   queue=readyNow

   if #queue==0 then
    if loopMode then
     routeStatus.Text="AUTO FARM++ / cashiers became busy / hopping"
     setWebhookStatus("Cashiers became busy • hopping")
     hopForAutoFarm()
    else
     stopRoute("No selected cashier is ready")
    end
    return
   end

   local _,uses=inventory()
   if uses<#queue then
    if config.autoBuy or loopMode then
     local bought,why=purchase(token,#queue,uses)
     if not bought then
      if valid(token) then log(why or "Purchase stopped") stopRoute(why) end
      return
     end

     local deadline=os.clock()+2.5
     repeat
      local _,n=inventory()
      uses=n
      if uses>=#queue then break end
      if not waitFor(0.06,token) then return end
     until os.clock()>=deadline
    end

    if uses<#queue then
     stopRoute("Not enough lockpick uses")
     return
    end
   end

   log("Farm cycle: "..#queue.." ready cashier(s), "..uses.." lockpick use(s) available.")

   while #queue>0 and valid(token) do
    local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then stopRoute("Character unavailable") return end

    table.sort(queue,function(a,b)
     return (a.position-root.Position).Magnitude<(b.position-root.Position).Magnitude
    end)

    local r=table.remove(queue,1)
    local result

    for n=1,config.retries do
     if not valid(token) then return end
     attempts+=1
     r.status="Attempt "..n
     routeStatus.Text="FARMING / "..r.name
     setWebhookStatus("Robbing • "..r.name)

     result=attempt(r,token)
     if result~="no-response" then break end
     if not waitFor(0.15*n,token) then return end
    end

    if not valid(token) then return end

    if result=="observed" then
     confirmed+=1
     r.status="Paid"
    elseif result=="accepted" then
     uncertain+=1
     r.status="Accepted"
    elseif result=="uncertain" then
     uncertain+=1
     r.status="Uncertain"
    elseif result=="tool" then
     stopRoute("No lockpick uses left")
     return
    elseif result=="seated" or result=="character" then
     stopRoute("Character not ready")
     return
    else
     skipped+=1
     r.status="Skipped"
    end

    log(r.name.." / "..r.status)

    -- Overnight fail-safe: a cashier that gives no usable response after all
    -- retries is treated as a bad/glitched server. Do not stop Auto Farm++;
    -- preserve the loop and immediately move to another unvisited server.
    if loopMode and result~="observed" and result~="accepted" and result~="uncertain" and result~="busy" and result~="missing" then
     routeStatus.Text="AUTO FARM++ / cashier glitched / hopping"
     setWebhookStatus("Cashier no response after retries • hopping")
     log("AUTO FARM++: "..r.name.." gave no usable response after "..tostring(config.retries).." retries; abandoning this server.")
     hopForAutoFarm()
     return
    end

    if not waitFor(0.05,token) then return end
   end

   if not loopMode then
    stopRoute("DONE / "..confirmed.." paid, "..uncertain.." uncertain")
    return
   end

   if confirmed+uncertain<=0 then
    routeStatus.Text="AUTO FARM++ / nothing paid / hopping"
    setWebhookStatus("No payout this server • hopping")
    log("AUTO FARM++: no accepted robbery signal; moving to another unvisited server.")
    hopForAutoFarm()
    return
   end

   routeStatus.Text="AUTO FARM++ / cycle done / hopping"
   setWebhookStatus("Cycle complete • hopping…")
   if not waitFor(0.15,token) then return end
   hopForAutoFarm()
  end,debug.traceback)

  if not ok and valid(token) then
   log(tostring(err))
   stopRoute("Error / farm stopped")
  end
 end)
end

