local function updateAvailability(r)

 local ready=available(r)

 if not ready and r.wasReady~=false then r.fullTransition=r.wasReady==true r.unavailableAt=os.clock() r.sawUnavailable=true end

 if ready and r.wasReady==false then

  if r.unavailableAt and r.fullTransition then r.measuredCooldown=os.clock()-r.unavailableAt end

  r.awaitCycle=false r.unavailableAt=nil

 end

 r.wasReady=ready

 return ready and not r.awaitCycle

end

