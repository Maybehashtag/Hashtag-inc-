local function commaNumber(value)
 value=math.floor(tonumber(value) or 0)
 local sign=value<0 and "-" or ""
 local n=tostring(math.abs(value))
 local out=n
 while true do
  local changed
  out,changed=out:gsub("^(%d+)(%d%d%d)","%1,%2")
  if changed==0 then break end
 end
 return sign..out
end

