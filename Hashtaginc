local function responseText(res)
 if type(res)=="table" then
  return tostring(res.Body or res.body or res.ResponseBody or "")
 end
 return type(res)=="string" and res or tostring(res or "")
end

local function responseStatus(res)
 if type(res)~="table" then return 0 end
 return tonumber(res.StatusCode or res.Status or res.status_code or res.status) or 0
end

local function webhookRequest(method,url,payload)
 local req,apiName=requestApi()
 if not req then
  webhookTransport="No HTTP API"
  webhookLastError="No compatible executor HTTP request function was found."
  return false,webhookLastError,-1
 end

 local encoded=HttpService:JSONEncode(payload)
 local headers={
  ["Content-Type"]="application/json",
  ["User-Agent"]="Mozilla/5.0"
 }

 local ok,res=pcall(req,{
  Url=url,
  Method=method,
  Headers=headers,
  Body=encoded,
  Timeout=8
 })

 if not ok then
  ok,res=pcall(req,{
   url=url,
   method=method,
   headers=headers,
   body=encoded,
   timeout=8
  })
 end

 if not ok then
  webhookTransport="Request error via "..tostring(apiName)
  webhookLastError=tostring(res)
  return false,webhookLastError,0
 end

 local status=responseStatus(res)
 local body=responseText(res)
 local successFlag=type(res)=="table" and (res.Success==true or res.success==true)
 local success=successFlag or (status>=200 and status<300)

 -- A few executor request APIs return a body but omit StatusCode. Discord's
 -- ?wait=true POST response is JSON containing a message id, so accept that.
 if not success and status==0 and method=="POST" and type(body)=="string" and body:match('"id"%s*:%s*"%d+"') then
  success=true
 end

 if success then
  webhookTransport="Connected via "..tostring(apiName)..(status>0 and (" / "..status) or "")
  webhookLastError=""
  return true,body,status
 end

 webhookTransport="HTTP "..tostring(status).." via "..tostring(apiName)
 webhookLastError=body~="" and body or "No response body"
 return false,body,status
end

local function webhookRetryDelay(body,status)
 if status==429 and type(body)=="string" and body~="" then
  local ok,data=pcall(function() return HttpService:JSONDecode(body) end)
  local value=ok and type(data)=="table" and tonumber(data.retry_after) or nil
  if value then
   if value>100 then value=value/1000 end
   return math.clamp(value+0.35,1,30)
  end
 end
 return status==0 and 3 or 2
end

local function clearWebhookMessageId()
 webhookMessageId=""
 setTeleportState(WEBHOOK_MESSAGE_KEY,"")
end

local function rememberWebhookMessage(body)
 if type(body)~="string" or body=="" then return false end
 local decodedOk,decoded=pcall(function() return HttpService:JSONDecode(body) end)
 local id=decodedOk and type(decoded)=="table" and decoded.id or body:match('"id"%s*:%s*"(%d+)"')
 if id then
  webhookMessageId=tostring(id)
  setTeleportState(WEBHOOK_MESSAGE_KEY,webhookMessageId)
  return true
 end
 return false
end

local function pushWebhook(force,recreate,quiet)
 if not config.webhook or webhookBusy then return false end
 if not force and not webhookDirty then return false end
 if not force and os.clock()<webhookRetryAt then return false end
 webhookBusy=true

 task.spawn(function()
  local completed,problem=xpcall(function()
   if recreate then clearWebhookMessageId() end

   local payload=webhookPayload()
   local ok,body,status=false,"",0

   -- One live card only: edit the known message. Never create another card just
   -- because an executor reports an odd PATCH status; only a confirmed 404 means
   -- the Discord message is actually gone and needs replacement.
   if webhookMessageId~="" then
    ok,body,status=webhookRequest("PATCH",WEBHOOK_URL.."/messages/"..webhookMessageId,payload)
    if not ok then
     if status==429 then
      webhookRetryAt=os.clock()+webhookRetryDelay(body,status)
      webhookDirty=true
      webhookLastPush=os.clock()
      if not quiet then log("Webhook rate limited / retrying automatically") end
      return
     elseif status==404 then
      clearWebhookMessageId()
     else
      webhookRetryAt=os.clock()+webhookRetryDelay(body,status)
      webhookDirty=true
      webhookLastPush=os.clock()
      if not quiet then log("Webhook edit failed / keeping the same message id / "..webhookTransport) end
      return
     end
    end
   end

   if webhookMessageId=="" then
    ok,body,status=webhookRequest("POST",WEBHOOK_URL.."?wait=true",payload)
    if ok then rememberWebhookMessage(body) end
   end

   webhookLastPush=os.clock()
   if ok then
    webhookDirty=false
    webhookRetryAt=0
    if force and not quiet then log("Webhook update OK / "..webhookTransport) end
   else
    webhookDirty=true
    webhookRetryAt=os.clock()+webhookRetryDelay(body,status)
    local short=tostring(webhookLastError or "")
    if #short>180 then short=short:sub(1,180).."…" end
    if not quiet then log("Webhook failed / "..webhookTransport..(short~="" and (" / "..short) or "")) end
   end
  end,debug.traceback)

  webhookBusy=false
  if not completed then
   webhookDirty=true
   webhookLastPush=os.clock()
   webhookRetryAt=os.clock()+3
   webhookTransport="Runtime error"
   webhookLastError=tostring(problem)
   if not quiet then log("Webhook error: "..tostring(problem)) end
  end
 end)
 return true
end

local function syncWebhookForTeleport()
 if not config.webhook then return end
 webhookDirty=true
 if not webhookBusy then pushWebhook(true,false,true) end
 local deadline=os.clock()+3.5
 while webhookBusy and os.clock()<deadline and not dead do task.wait(0.05) end
 if webhookMessageId=="" then
  local saved=tostring(getTeleportState(WEBHOOK_MESSAGE_KEY) or "")
  if saved~="" then webhookMessageId=saved end
 end
end

