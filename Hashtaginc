armAutoCountdown=function(fromTeleport)
 if dead or not autoLoop then return end
 countdownToken+=1
 local token=countdownToken
 local duration=fromTeleport and AUTO_REJOIN_DELAY or AUTO_START_DELAY
 countdownActive=true
 countdownRemaining=duration
 countdownDeadline=os.clock()+duration
 countdownLastTick=os.clock()

 if fromTeleport and (landedOnVisited or (previousJob~="" and previousJob==game.JobId)) then
  countdownActive=false
  countdownRemaining=0
  countdownDeadline=0
  routeStatus.Text="AUTO FARM++ / repeated server / rehopping"
  setWebhookStatus("Repeated server detected • hopping again")
  log("AUTO FARM++: landed in an already visited server; hopping again.")
  task.delay(1,function()
   if not dead and autoLoop and token==countdownToken then hopForAutoFarm() end
  end)
  return
 end

 local prefix=fromTeleport and "New server joined" or "Auto Farm++ started"
 log(prefix.." / waiting "..tostring(duration).."s before farm readiness checks.")

 task.spawn(function()
  local lastShown=nil
  while not dead and autoLoop and token==countdownToken do
   local remaining=math.max(0,math.ceil(countdownDeadline-os.clock()))
   countdownRemaining=remaining
   countdownLastTick=os.clock()

   if remaining~=lastShown then
    lastShown=remaining
    if remaining>0 then
     routeStatus.Text="AUTO FARM++ / farming in "..remaining.."s"
     webhookStatus="Waiting • farm in "..remaining.."s"
     webhookDirty=true
    end
   end

   if remaining<=0 then break end
   task.wait(0.1)
  end

  if dead or not autoLoop or token~=countdownToken then return end
  countdownRemaining=0
  countdownActive=false
  countdownDeadline=0
  routeStatus.Text="AUTO FARM++ / starting"
  webhookStatus="Starting farm"
  webhookDirty=true
  task.defer(beginResumeHandoff)
 end)
end

